# ==============================================================================
# WANFINANCE - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NOTA: Não preencha segredos reais neste arquivo. Todas as credenciais corporativas
# devem ser injetadas com segurança no ambiente de hospedagem / secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTIFICAÇÃO DE AMBIENTE (Configurável para Desenvolvimento / Homologação)
# ------------------------------------------------------------------------------
# Ambientes válidos: DEVELOPMENT | HOMOLOGATION | PRODUCTION
APP_ENV=DEVELOPMENT

# URL pública da aplicação (Injetada pelo Cloud Run ou informada pela infraestrutura)
APP_URL=

# Segredo criptográfico para assinatura de sessões (Gerado automaticamente em DEV se omitido)
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 2. INTELIGÊNCIA ARTIFICIAL (Extração Inteligente de Boletos PDF/Imagem)
# ------------------------------------------------------------------------------
# Chave da API Google Gemini (Gerenciada no backend via Secrets)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. BANCO DE DADOS CORPORATIVO (PostgreSQL Direto)
# NOTA: Pendente de fornecimento pela equipe de TI / DBA. O sistema opera em modo
# desenvolvimento local seguro até que os dados formais de infraestrutura sejam passados.
# ------------------------------------------------------------------------------
# [TI / DBA] Host do banco de dados corporativo (PostgreSQL)
DATABASE_HOST=
# [TI / DBA] Porta de conexão (padrão: 5432)
DATABASE_PORT=
# [TI / DBA] Nome do banco de dados Wanfinance
DATABASE_NAME=
# [TI / DBA] Usuário de conexão corporativo
DATABASE_USER=
# [TI / DBA] Senha de conexão corporativa
DATABASE_PASSWORD=
# [TI / DBA] Nível de segurança SSL (require / verify-full / disable)
DATABASE_SSL=

# ------------------------------------------------------------------------------
# 4. SUPABASE / POSTGRESQL MULTI-TENANT (Opcional - Backend ou Frontend Seguro)
# ------------------------------------------------------------------------------
# [TI / DBA] URL da instância Supabase corporativa
VITE_SUPABASE_URL=
# [TI / DBA] Chave anônima pública (restrita pelas políticas RLS do schema)
VITE_SUPABASE_ANON_KEY=
# [TI / DBA] Chave administrativa restrita (EXCLUSIVA DO SERVIDOR, NUNCA NO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 5. APIS BANCÁRIAS E CERTIFICADOS DIGITAIS mTLS
# NOTA: Integração mantida PREPARADA no código, porém DESATIVADA até homologação
# formal e fornecimento dos certificados digitais pela equipe de TI.
# NÃO CONFIGURAR COMO 'PRODUCTION' NESTE MOMENTO.
# ------------------------------------------------------------------------------
# Ambiente bancário: DEVELOPMENT | HOMOLOGACAO | PRODUCTION (Padrão: DEVELOPMENT)
BANK_API_ENV=DEVELOPMENT

# [TI] Caminho no servidor para o arquivo de certificado corporativo mTLS (A1 / PEM)
BANK_MTLS_CERT_PATH=
# [TI] Senha do certificado digital corporativo mTLS
BANK_MTLS_CERT_PASS=

# ==============================================================================
# VARIÁVEIS DEPRECIADAS / PROIBIDAS (NÃO UTILIZAR):
# - ADMIN_PASSWORD: NÃO UTILIZAR (senhas estáticas em variáveis foram eliminadas).
# - OPERATOR_PASSWORD: NÃO UTILIZAR (senhas corporativas gerenciadas dinamicamente).
# ==============================================================================

